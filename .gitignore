# logs and local test artifacts
tools/*.log
tools/server.pid
tools/node-procs.json
tools/env-probe.txt
tools/gh-token.txt
tools/device-flow.json
tools/push-state.json
.DS_Store
Thumbs.db

tools/deploy-key
tools/deploy-key.pub

# the 高德 IP-location key (optional; see server.js geoLookup)
tools/geo-key.txt

# the Supabase read secret for the visitor table (optional; see tools/supabase-visits.sql)
tools/sb-key.txt

# the visitor roll — real addresses of real people, local only.
# it must never reach the public site (docs/ is what Pages publishes).
docs/data/visits.json
# cloud rows dismissed from the local page (ids only; the rows themselves
# stay in the shared table — see server.js DELETE /api/visits)
docs/data/visits-hidden.json
# resolved places, keyed by the address they belong to (see geoLookup).
# same rule as the roll: real addresses of real people, local only.
docs/data/geo-cache.json

# ---- OWNER-ONLY PAGES: never publish these ----
# docs/ IS the GitHub Pages root, so anything left in it goes online.
# The visitor roll lists real people's IPs and locations: it is strictly
# a local page. Ignored here rather than deleted so you keep working on
# it; the file stays on disk and the local server still serves it.
# (journal.html was removed for the same reason — see AI-HANDOVER §0.33.)
docs/visits.html
docs/js/visits.js
# the theatre around the roll — code rain, wire, scope, event log.
# only visits.html loads it; same owner-only rule as everything above.
docs/js/visits-fx.js
# only styles the page above — no reason to ship it
docs/css/visits.css

# the cute login gate's password + owner welcome lines. Lives at the repo
# ROOT (outside docs/), never shipped to the browser, and never published.
# It holds the gate password, so it must never reach GitHub — keep it local.
server-gate.json

# ---- Rem: the local conversation ----
# Same rule as the visitor roll: it runs on this machine only, and the
# portrait is a character illustration that is not ours to redistribute.
docs/rem.html
docs/js/rem.js
docs/js/puppet.js
docs/js/mood.js
docs/js/kurisu-lines.js
docs/js/kurisu-pool.js
docs/js/kurisu-voice.js
docs/js/steinsgate-kb.js
docs/css/rem.css
docs/assets/rem/
# the Live2D / PIXI runtime those four files above load. Only rem.html
# asks for it, and it is third-party code we are not redistributing.
docs/vendor/live2d/

# If you ever add another local-only page, put it here too. The check is
# simple: does the page show anyone's IP, address, or visit history?

# the retired journal — kept locally as an archive of what was written,
# but its page and data must not sit in the published tree either.
tools/_archive/

# guard rail: `node tools/check-private-pages.js` must print SAFE TO PUSH
# before any commit. It catches the cases .gitignore does not (git add -f).
